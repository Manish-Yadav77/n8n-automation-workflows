      "parameters": {
        "jsCode": "const responseText = $input.first().json.output;\ntry {\n  const cleanJson = responseText.replace(/```json/g, '').replace(/```/g, '').trim();\n  const parsed = JSON.parse(cleanJson);\n  return [{ json: { ...$input.first().json, classification: parsed } }];\n} catch (e) {\n  return [{ json: { ...$input.first().json, classification: {\n    category: \"IRRELEVANT_PROMO\",\n    company_name: \"Unknown\",\n    job_role: \"Unknown\",\n    requires_action: false,\n    action_summary: \"Failed to parse response\",\n    draft_reply_needed: false,\n    suggested_reply: \"\"\n  } } }];\n}"
      },
